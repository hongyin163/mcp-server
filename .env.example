# MCP gateway service port
PORT=3002

# Comma-separated CORS allowlist. Empty means allow all.
ALLOWED_ORIGINS=

# Admin API bearer token for /admin/* routes
MCP_ADMIN_TOKEN=

# Allowed request-scoped passthrough auth headers from x-mcp-auth-*
MCP_PASSTHROUGH_AUTH_HEADERS=authorization,x-api-key

# Filesystem MCP base directory
MCP_FS_BASE_DIR=./workspace

# Example remote MCP auth env var used by auth.envHeaders
THIRD_PARTY_MCP_AUTH=

# If true, skip automatically loading config.json when running on Vercel or other serverless platforms.
# Use this if you only want to deploy the gateway as a proxy and avoid local stdio child process registration.
MCP_DISABLE_AUTO_REGISTER=false

# Path to the MCP config file. Can be overridden on the command line or in runtime environments.
MCP_CONFIG_FILE=./config.json
