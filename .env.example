# MCP gateway service port
PORT=3002

# Comma-separated CORS allowlist. Empty means allow all.
ALLOWED_ORIGINS=

# Admin API bearer token for /admin/* routes
MCP_ADMIN_TOKEN=

# Allowed request-scoped passthrough auth headers from x-mcp-auth-*
MCP_PASSTHROUGH_AUTH_HEADERS=authorization,x-api-key

# Filesystem MCP base directory
MCP_FS_BASE_DIR=./workspace

# Example remote MCP auth env var used by auth.envHeaders
THIRD_PARTY_MCP_AUTH=
